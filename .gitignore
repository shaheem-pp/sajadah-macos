# ===== Xcode / Swift =====

# Build
DerivedData/
build/
*.xcarchive
*.ipa
*.dmg
*.dSYM
*.dSYM.zip

# User-specific Xcode settings
*.xcuserstate
xcuserdata/

# Xcode playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
Packages/
Package.pins
# Package.resolved is deliberately NOT ignored: it pins exact dependency versions, so
# committing it is what makes a clone build the same code you built. Only the surrounding
# swiftpm state is noise.
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Logs
*.log

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
*.mobileprovision
*.p12
*.cer

# IDEs
.idea/
.vscode/
*.swp
*.swo

# ===== Deliberately tracked =====
#
# Do not add rules that would catch these — each is generated, but committing it is the point:
#
#   Sajadah.xcodeproj/xcshareddata/xcschemes/   Shared schemes. Without them a fresh clone
#                                               cannot `xcodebuild -scheme Sajadah`, and
#                                               scripts/release.sh fails. (xcuserdata/ above
#                                               already excludes the per-user ones.)
#   Sajadah/Assets.xcassets/**/*.png            The app icon. Regenerate with
#                                               ./scripts/make-icon.sh
#   docs/brand/*.png                            README artwork.
